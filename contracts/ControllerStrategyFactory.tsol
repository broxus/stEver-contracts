pragma ever-solidity >=0.62.0;
pragma AbiHeader expire;
pragma AbiHeader pubkey;

import "./interfaces/IDepoolStrategyFactory.tsol";
import "./interfaces/IStEverCluster.tsol";
import "./interfaces/IStrategy.tsol";
import "./utils/Constants.tsol";
import "./utils/ErrorCodes.tsol";
import "@broxus/contracts/contracts/libraries/MsgFlag.tsol";
import {ControllerStrategyFactoryGas} from "./utils/Gas.tsol";
import {GasUtils} from "./utils/GasUtils.tsol";


/**
 * @title ControllerStrategyFactory
 *
 * @dev Implementation of the {IControllerStrategyFactory} interface.
 *
 * This contract is responsible for creating and managing Controller strategies.
 * It also handles the upgrade of strategies and the transfer of ownership.
 */
contract ControllerStrategyFactory is IDepoolStrategyFactory {
    uint32 constant CONTROLLER_TOP_UP = 0xd372158c;

    // static variables
    uint128 public static nonce;
    TvmCell public static controllerStrategyCode;
    address public static stEverVault;
    address public static elector;

    // state variables
    address owner;
    uint32 public strategyVersion;
    uint32 public strategyCount;
    uint32 public factoryVersion;

    // error codes
    uint16 constant NOT_OWNER = 6001;
    uint16 constant LOW_MSG_VALUE = 6002;
    uint16 constant WRONG_PUBKEY = 6003;

    /**
     * @dev Sets the initial owner of the contract.
     * @param _owner The address of the initial owner.
     *
     * **Preconditions**:
     *
     * - The contract must be deployed with a non-zero public key.
     * - The contract must be deployed with the same public key as the message.
     */
    constructor(address _owner) public {

        require (tvm.pubkey() != 0, WRONG_PUBKEY);
        require (tvm.pubkey() == msg.pubkey(), WRONG_PUBKEY);

        tvm.accept();

        owner = _owner;
    }

    /**
     * @dev Modifier to make a function callable only when the caller is the owner.
     */
    modifier onlyOwner() {
        require(msg.sender == owner,NOT_OWNER);
        _;
    }

    /**
     * @dev Modifier to make a function callable only when the call value is above a certain threshold.
     */
    modifier minCallValue() {
        require (msg.value >= ControllerStrategyFactoryGas.MIN_CALL_VALUE, ErrorCodes.NOT_ENOUGH_VALUE_FACTORY);
        _;
    }

    /**
    * @dev Calculates the reserve by taking the maximum of the contract's
    * current balance minus the value sent in the message
    * (i.e., the amount of native coins sent with the current transaction) and the
    * minimum balance of the contract (as determined by the {ControllerStrategyFactoryGas.CONTRACT_MIN_BALANCE} constant).
    *
    * This ensures that the reserve is set to the higher of the contract's
    * current balance minus the message value or its minimum balance, ensuring that the contract
    * does not spend more native coins than it has available.
    *
    * @return The calculated reserve.
    */
    function _reserve() internal pure returns (uint128) {
		return
			math.max(address(this).balance - msg.value, ControllerStrategyFactoryGas.CONTRACT_MIN_BALANCE);
	}

    /**
     * @dev See {IControllerStrategyFactory-getDetails}.
     */
    function getDetails() override external responsible view returns (FactoryDetails) {
        return {value:0, bounce: false, flag: MsgFlag.REMAINING_GAS} FactoryDetails({
            stEverVault: stEverVault,
            owner: owner,
            strategyVersion: strategyVersion,
            strategyCount: strategyCount,
            factoryVersion: factoryVersion
        });
    }
    /**
     * @dev See {IControllerStrategyFactory-transferOwnership}.
     *
     * **Preconditions**:
     *
     *  - Only the owner can call this function.
     *
     * Postcondition:
     *  - The owner is set to `_newOwner`.
     */
    function transferOwnership(address _newOwner, address _sendGasTo) override external onlyOwner {
        tvm.rawReserve(_reserve(), 0);

        owner = _newOwner;

        _sendGasTo.transfer({value: 0, flag:MsgFlag.ALL_NOT_RESERVED, bounce: false});
    }

    /**
     * @dev See {IControllerStrategyFactory-installNewStrategyCode}.
     *
     * **Preconditions**:
     *
     *  - The call value must be greater than or equal to {ControllerStrategyFactoryGas.UPGRADE_VALUE}.
     *  - Only the owner can call this function.
     *
     * Postcondition:
     *  - The strategy code is set to `_strategyCode`.
     */
    function installNewStrategyCode(TvmCell _strategyCode, address _sendGasTo) override external onlyOwner {
        require (msg.value >= ControllerStrategyFactoryGas.UPGRADE_VALUE, LOW_MSG_VALUE);
        tvm.rawReserve(_reserve(),0);

        controllerStrategyCode = _strategyCode;
        strategyVersion++;
        emit StrategyCodeUpdated(strategyVersion - 1,strategyVersion);

        _sendGasTo.transfer({value: 0, flag: MsgFlag.ALL_NOT_RESERVED, bounce: false});
    }

    /**
     * @dev See {IControllerStrategyFactory-deployStrategy}.
     *
     * **Preconditions**:
     *
     *  - The call value must be greater than or equal to
     *    {ControllerStrategyFactoryGas.STRATEGY_DEPLOY_VALUE} + {ControllerStrategyFactoryGas.MIN_CALL_VALUE}.
     *  - Only the owner can call this function.
     *
     * Postcondition:
     *  - A new strategy is deployed.
     *  - The strategy count is incremented.
     *  - The strategy is initialized.
     *  - Calls `onStrategyDeployed` on the StEverCluster contract, registering the strategy.
     *
     */

    function buildControllerAddress(uint32 controllerId, address validator) internal view returns (address controllerAddress, TvmCell stateInit)  {
        TvmBuilder staticDataBuilder;
        staticDataBuilder.store(controllerId);
        staticDataBuilder.store(validator);
        staticDataBuilder.store(stEverVault);
        staticDataBuilder.store(stEverVault);

        TvmBuilder ref;
        ref.store(stEverVault);
        ref.store(stEverVault);
        ref.store(elector);

        staticDataBuilder.store(ref.toCell());

        TvmBuilder controllerInitData;
        uint8 state = 0;
        controllerInitData.store(state);

        bool halted = false;
        controllerInitData.store(halted);

        bool approved = true;
        controllerInitData.store(approved);

        uint128 stake_amount_sent = 0;
        controllerInitData.store(stake_amount_sent);

        uint32 stake_at = 0;
        controllerInitData.store(stake_at);

        uint256 saved_validator_set_hash = 0;
        controllerInitData.store(saved_validator_set_hash);

        uint8 validator_set_changes_count = 0;
        controllerInitData.store(validator_set_changes_count);

        uint32 validator_set_change_time = 0;
        controllerInitData.store(validator_set_change_time);

        uint32 stake_held_for = 0;
        controllerInitData.store(stake_held_for);

        uint128 borrowed_amount = 0;
        controllerInitData.store(borrowed_amount);

        uint32 borrowing_time = 0;
        controllerInitData.store(borrowing_time);

        uint2 sudoer_addr_none;
        controllerInitData.store(sudoer_addr_none);

        uint48 sudoer_set_at = 0;
        controllerInitData.store(sudoer_set_at);



        uint24 maxExpectedInterest = 0;
        controllerInitData.store(maxExpectedInterest);

        controllerInitData.store(staticDataBuilder.toCell());

        stateInit = tvm.buildStateInit(controllerStrategyCode, controllerInitData.toCell());
        controllerAddress = address.makeAddrStd(-1,tvm.hash(stateInit));
    }


    function deployStrategy(address _validator) override external {
        require (msg.value >= GasUtils.convertEverGas(ControllerStrategyFactoryGas.STRATEGY_DEPLOY_VALUE) + ControllerStrategyFactoryGas.MIN_CALL_VALUE, LOW_MSG_VALUE);
        tvm.rawReserve(_reserve(), 0);

        (address controller, TvmCell stateInit) = buildControllerAddress(strategyCount, _validator);

        TvmBuilder body;
        body.store(CONTROLLER_TOP_UP);
        body.store(uint64(strategyCount));

        strategyCount++;

        controller.transfer({
            stateInit: stateInit,
            flag: 2,
            body: body.toCell(),
            value: ControllerStrategyFactoryGas.STRATEGY_DEPLOY_VALUE
        });


        emit NewStrategyDeployed(controller,_validator, strategyVersion);

        IStEverCluster(msg.sender).onStrategyDeployed{
            value: 0,
            flag: MsgFlag.ALL_NOT_RESERVED,
            bounce: false
        }(controller);
    }

    /**
     * @dev See {IControllerStrategyFactory-upgradeStrategies}.
     *
     * **Preconditions**:
     *
     *  - Only the owner can call this function.
     *  - The number of strategies to upgrade must be less than or equal to Constants.MAX_STRATEGY_PER_UPGRADE.
     *  - The call value must be greater than or equal to
     *    ControllerStrategyFactoryGas.MIN_CALL_VALUE * _strategies.length + ControllerStrategyFactoryGas.MIN_CALL_VALUE.
     *
     * Postcondition:
     * - Calls `upgrade` on each strategy in `_strategies`.
     */
    function upgradeStrategies(address[] _strategies) override external onlyOwner {
        require (_strategies.length <= Constants.MAX_STRATEGY_PER_UPGRADE, ErrorCodes.MAX_STRATEGY_THAN_ALLOWED);
        require (
            msg.value >= ControllerStrategyFactoryGas.MIN_CALL_VALUE * _strategies.length + ControllerStrategyFactoryGas.MIN_CALL_VALUE,
            ErrorCodes.NOT_ENOUGH_VALUE_FACTORY
        );

        tvm.rawReserve(_reserve(),0);

        for (address strategy : _strategies) {
            IStrategy(strategy).upgrade{
                    value: ControllerStrategyFactoryGas.MIN_CALL_VALUE,
                    bounce: false
            }(controllerStrategyCode, strategyVersion, msg.sender);
        }

        msg.sender.transfer({value: 0, flag: MsgFlag.ALL_NOT_RESERVED, bounce: false});
    }

    /**
     * @dev See {IControllerStrategyFactory-upgrade}.
     *
     * Precondition:
     *  - Should be called only by the owner.
     *
     * Postcondition:
     * - Factory code is changed to `_newCode`.
     */
    function upgrade(TvmCell _newCode, uint32 _newVersion, address _sendGasTo) override external onlyOwner minCallValue {
        if (_newVersion == factoryVersion) {
            tvm.rawReserve(_reserve(), 0);
            _sendGasTo.transfer({value: 0, flag: MsgFlag.ALL_NOT_RESERVED, bounce:false});
            return;
        }

        // should be unpacked in the same order!
        TvmCell data = abi.encode(
            _sendGasTo, // address
            _newVersion, // uint32
            controllerStrategyCode, // TvmCell
            stEverVault, // address
            owner, // address
            strategyVersion, // uint32
            strategyCount, // uint32
            factoryVersion // uint32
        );

        // set code after complete this method
        tvm.setcode(_newCode);
        // run onCodeUpgrade from new code
        tvm.setCurrentCode(_newCode);

        onCodeUpgrade(data);
    }

    /**
     * @dev Handles the code upgrade.
     * @param _upgradeData The data of the upgrade.
     */
    function onCodeUpgrade(TvmCell _upgradeData) private {}

}
